{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "agent-server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "agent_server.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Basic Client",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\scripts\\ws_client.py",
            "args": [
                "--working-dir",
                "${workspaceFolder}\\test"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "compounds": [
        {
            "name": "Launch basic client and agent-server",
            "configurations": [
                "agent-server",
                "Basic Client"
            ],
            "stopAll": true
        }
    ]
}